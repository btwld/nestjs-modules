{
  "name": "@concepta/nestjs-core",
  "version": "8.0.0-alpha.14",
  "description": "Rockets App - Core framework module for Rockets applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aggregate": {
      "types": "./dist/index-aggregate.d.ts",
      "default": "./dist/index-aggregate.js"
    },
    "./optional/money": {
      "types": "./dist/optional-money.d.ts",
      "default": "./dist/optional-money.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btwld/nestjs-modules.git",
    "directory": "packages/nestjs-core"
  },
  "bugs": {
    "url": "https://github.com/btwld/nestjs-modules/issues"
  },
  "homepage": "https://github.com/btwld/nestjs-modules#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@types/ms": "^2.1.0",
    "ms": "^2.1.3",
    "rxjs": "^7.8.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/microservices": "~12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/supertest": "^6.0.3",
    "decimal.js": "^10.6.0",
    "supertest": "^6.3.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "decimal.js": "^10.6.0",
    "rxjs": "^7.8.1",
    "vitest": ">=4.0.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/cqrs": {
      "optional": true
    },
    "decimal.js": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "vitest-mock-extended": {
      "optional": true
    }
  }
}
