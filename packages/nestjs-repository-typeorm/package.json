{
  "name": "@concepta/nestjs-repository-typeorm",
  "version": "8.0.0-alpha.15",
  "description": "Rockets NestJS TypeORM Repository Module",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btwld/nestjs-modules.git",
    "directory": "packages/nestjs-repository-typeorm"
  },
  "bugs": {
    "url": "https://github.com/btwld/nestjs-modules/issues"
  },
  "homepage": "https://github.com/btwld/nestjs-modules#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "workspace:*",
    "@concepta/nestjs-repository": "workspace:*"
  },
  "devDependencies": {
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/outbox": "^0.1.4",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.0.0",
    "mssql": "12.7.13",
    "mysql2": "3.24.6",
    "oracledb": "6.10.0",
    "pg": "8.23.1",
    "supertest": "^7.3.1",
    "typeorm": "^1.1.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/outbox": "^0.1.4",
    "@nestjs/typeorm": "^12.0.1",
    "typeorm": "^0.3.31 || ^1.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/outbox": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "default": "./dist/mysql.js"
    },
    "./mariadb": {
      "types": "./dist/mariadb.d.ts",
      "default": "./dist/mariadb.js"
    },
    "./oracle": {
      "types": "./dist/oracle.d.ts",
      "default": "./dist/oracle.js"
    },
    "./sqlserver": {
      "types": "./dist/sqlserver.d.ts",
      "default": "./dist/sqlserver.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./optional/outbox": {
      "types": "./dist/optional-outbox.d.ts",
      "default": "./dist/optional-outbox.js"
    }
  }
}
