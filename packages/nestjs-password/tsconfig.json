{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "../../node_modules"
